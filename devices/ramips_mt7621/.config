#=================================================
# 目标: MediaTek MT7621 (ramips/mt7621)
# 设备: Xiaomi Mi Router CR660X —— 只出这一个设备的固件
#
# 设备名来自本目录 patches/02-cr660x.patch:
# 该补丁把上游的 cr6606 / cr6608 / cr6609 合并成单一设备
# xiaomi_mi-router-cr660x，并额外产出 factory.bin。
#
# devices/common/.config 里默认是:
#   CONFIG_TARGET_MULTI_PROFILE=y
#   CONFIG_TARGET_ALL_PROFILES=y   <- 会编译该目标下全部设备
# 本文件在后面追加，把 ALL_PROFILES 关掉，只保留 CR660X。
#=================================================

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y

# --- 只编指定设备 ---
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# --- 唯一选中的设备 ---
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_xiaomi_mi-router-cr660x=y
